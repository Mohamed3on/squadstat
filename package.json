{
  "name": "squadstat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "build:worker": "opennextjs-cloudflare build && tsgo --noEmit",
    "preview": "bun run build:worker && opennextjs-cloudflare preview",
    "deploy": "bun run build:worker && opennextjs-cloudflare deploy",
    "lint": "oxlint",
    "typecheck": "tsgo --noEmit",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "refresh:minutes-value": "bun run scripts/refresh-minutes-value.ts",
    "refresh:biggest-movers": "bun run scripts/refresh-biggest-movers.ts",
    "refresh:transfer-balance": "bun run scripts/refresh-transfer-balance.ts",
    "refresh:squad-values": "bun run scripts/refresh-squad-values.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-virtual": "^3.13.18",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "geist": "^1.7.0",
    "lucide-react": "^0.563.0",
    "next": "^15.5.27",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.10",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vitest": "^4.0.18",
    "wrangler": "^4.149.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": "oxlint --max-warnings 0",
    "*.{ts,tsx,css,md}": "oxfmt --write"
  }
}
